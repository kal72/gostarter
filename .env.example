# ─── GoStarter Application Configuration ───────────────────────────────────────
APP_NAME=gostarter
APP_ENV=development
APP_PORT=8080
APP_READ_TIMEOUT=30s
# Minimum 60s: API wait up to 10s + bounded regeneration up to 45s.
APP_WRITE_TIMEOUT=60s
APP_IDLE_TIMEOUT=120s

# ─── PostgreSQL Database Configuration ─────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=gostarter
DB_SSLMODE=disable

# Optional: Direct Database URL (takes precedence over DB_HOST / DB_USER / etc.)
# DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/gostarter?sslmode=disable

DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15m

# ─── Upstream Reference Architecture ───────────────────────────────────────────
UPSTREAM_OWNER=kal72
UPSTREAM_REPO=go-feature-based-boilerplate
UPSTREAM_BRANCH=main
# Optional server-side GitHub API token; empty uses unauthenticated requests
GITHUB_TOKEN=

# ─── Admin Authentication Configuration ────────────────────────────────────────
ADMIN_DEFAULT_USER=admin
ADMIN_DEFAULT_PASSWORD=admin123
ADMIN_SESSION_LIFETIME=24h

# Metadata and immutable upstream archives (mount SNAPSHOT_DIR on a persistent volume)
SNAPSHOT_DIR=.cache/snapshots
PLAN_LIFETIME=24h
SNAPSHOT_RETAIN_COUNT=5
VALIDATION_MAX_PENDING_JOBS=100
VALIDATION_DIAGNOSTIC_BYTES=8192

# Embedded validation worker (sync requested manually through Admin)
VALIDATION_CONCURRENCY=2
VALIDATION_POLL_INTERVAL=1s
VALIDATION_JOB_TIMEOUT=10m
VALIDATION_LEASE_DURATION=30s
VALIDATION_MAX_ATTEMPTS=2
VALIDATION_MAX_CASES=64
# Set a dedicated temporary workspace volume in deployment (default: OS temp directory)
# VALIDATION_WORKSPACE_DIR=/tmp/gostarter-validation
UPSTREAM_SYNC_TIMEOUT=2m
