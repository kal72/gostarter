package ui

import "gostarter/internal/web/ui/layouts"

import "gostarter/internal/web/ui/components"

templ AdminPage(model AdminPageModel) {
 @layouts.Layout("GoStarter — Admin Console", "bg-slate-50 dark:bg-dark-bg text-slate-900 dark:text-slate-100 font-sans min-h-screen transition-colors duration-200") {
  if model.User == nil {
   @components.LoginPanel()
  } else {
   @AdminDashboard(model)
   @components.PasswordDialog()
  }
 }
}

templ AdminDashboard(model AdminPageModel) {
<div id="dashboardSection">
    
    <header class="sticky top-0 z-50 backdrop-blur-md bg-white/80 dark:bg-dark-card/80 border-b border-slate-200 dark:border-dark-border px-6 sm:px-10 py-4">
      <div class="max-w-7xl mx-auto flex items-center justify-between">
        <div class="flex items-center gap-3">
          <a href="/" class="flex items-center gap-2 group" title="Back to GoStarter Initializr">
            <div class="w-9 h-9 rounded-xl bg-brand-500/10 border border-brand-500/30 flex items-center justify-center p-1 text-brand-500 shadow-sm group-hover:scale-105 transition-transform">
              <svg class="w-6 h-6" viewBox="0 0 48 48" fill="none">
                <path d="M4 18h7M2 24h11M5 30h6" stroke="#00ADD8" stroke-width="2.4" stroke-linecap="round"/>
                <circle cx="21" cy="13" r="4" fill="#00ADD8"/><circle cx="21" cy="13" r="2" fill="#7FE2F8"/>
                <circle cx="38" cy="13" r="4" fill="#00ADD8"/><circle cx="38" cy="13" r="2" fill="#7FE2F8"/>
                <path d="M18 22C18 15.5 23.5 10 30 10C36.5 10 42 15.5 42 22V34C42 38.5 38.5 42 34 42H26C21.5 42 18 38.5 18 34V22Z" fill="#00ADD8"/>
                <circle cx="25" cy="21" r="4.8" fill="#FFFFFF"/><circle cx="36" cy="21" r="4.8" fill="#FFFFFF"/>
                <circle cx="26.2" cy="21" r="2.2" fill="#0F172A"/><circle cx="34.8" cy="21" r="2.2" fill="#0F172A"/>
                <ellipse cx="30.5" cy="26.5" rx="4.2" ry="2.6" fill="#FFFFFF"/><ellipse cx="30.5" cy="25.6" rx="1.8" ry="1.2" fill="#0F172A"/>
                <rect x="28.8" y="28.6" width="1.6" height="2.4" rx="0.4" fill="#FFFFFF"/><rect x="30.8" y="28.6" width="1.6" height="2.4" rx="0.4" fill="#FFFFFF"/>
              </svg>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="text-lg font-bold tracking-tight text-slate-900 dark:text-white">GO<span class="text-brand-500">STARTER</span></span>
                <span class="text-[10px] font-bold tracking-wider px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-600 dark:text-purple-400 border border-purple-500/30">ADMIN</span>
              </div>
            </div>
          </a>
        </div>

        <div class="flex items-center gap-3">
          
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl border border-slate-200 dark:border-dark-border bg-slate-50 dark:bg-dark-surface text-xs">
            <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
            <span id="headerUsername" class="font-semibold text-slate-800 dark:text-slate-200">{ model.User.Username }</span>
          </div>

          
          <button type="button" id="btnOpenChangePassword" x-on:click="$refs.passwordDialog.showModal()" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-slate-200 dark:border-dark-border bg-slate-100 dark:bg-dark-surface hover:border-brand-500/50 transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <span class="hidden sm:inline">Change Password</span>
          </button>

          
          <button type="button" id="btnLogout" hx-post="/ui/admin/logout" hx-swap="none" class="text-xs font-semibold px-3 py-1.5 rounded-lg border border-rose-500/30 bg-rose-500/10 text-rose-500 hover:bg-rose-500/20 transition-all flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
              <polyline points="16 17 21 12 16 7"/>
              <line x1="21" y1="12" x2="9" y2="12"/>
            </svg>
            <span>Logout</span>
          </button>

          
          <button type="button" id="themeToggle" x-on:click="toggleTheme()" class="p-2 rounded-xl border border-slate-200 dark:border-dark-border bg-slate-100 dark:bg-dark-surface text-slate-600 dark:text-slate-300 hover:text-brand-500">
            <svg id="sunIcon" class="w-4 h-4 hidden dark:block" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
            <svg id="moonIcon" class="w-4 h-4 block dark:hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
            </svg>
          </button>
        </div>
      </div>
    </header>

    
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-6">
      
      
      <div id="adminStats" hx-get="/ui/admin/status" hx-trigger="every 5s, admin-refresh from:body" hx-swap="innerHTML" hx-sync="this:replace">
 @components.AdminStats(model.Source)
 </div>
 <div id="adminNotice" role="status"></div>

 <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 items-start">
        
        <section class="min-w-0 bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-2xl p-6 shadow-sm space-y-5">
          <div class="border-b border-slate-200 dark:border-dark-border pb-4">
            <h2 class="text-base font-semibold text-slate-900 dark:text-white">Default Initializr Settings</h2>
            <p class="text-xs text-slate-500 dark:text-slate-400">Configure global defaults saved in PostgreSQL</p>
          </div>

          <form id="settingsForm" method="post" action="/ui/admin/settings" hx-post="/ui/admin/settings" hx-target="#adminNotice" hx-disabled-elt="find button[type=submit]" class="space-y-4">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="settingUpstreamRepo" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Upstream Repository</label>
                <input id="settingUpstreamRepo" name="upstream_repo" value={ model.Settings.UpstreamRepo } placeholder="owner/repo" class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono bg-slate-50 dark:bg-dark-input border border-slate-200 dark:border-dark-border text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500" required>
              </div>
              <div>
                <label for="settingUpstreamRef" class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Upstream Branch / Ref</label>
                <input id="settingUpstreamRef" name="upstream_branch" value={ model.Settings.UpstreamBranch } class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono bg-slate-50 dark:bg-dark-input border border-slate-200 dark:border-dark-border text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500" required>
              </div>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Default Group Prefix</label>
                <input type="text" id="settingGroup" name="default_group" value={ model.Settings.DefaultGroup } class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono bg-slate-50 dark:bg-dark-input border border-slate-200 dark:border-dark-border text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500">
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Default Service Name</label>
                <input type="text" id="settingService" name="default_service" value={ model.Settings.DefaultService } class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono bg-slate-50 dark:bg-dark-input border border-slate-200 dark:border-dark-border text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500">
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Default Go Version</label>
                <input id="settingGoVersion" name="default_go_version" value={ model.Settings.DefaultGoVersion } placeholder="1.27.1" required class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono bg-slate-50 dark:bg-dark-input border border-slate-200 dark:border-dark-border">
              </div>

              <div>
                <label class="block text-xs font-semibold uppercase tracking-wider text-slate-500 mb-1">Default Protocol</label>
                <select id="settingProtocol" name="default_protocol" class="w-full px-3.5 py-2.5 rounded-xl text-xs font-mono bg-slate-50 dark:bg-dark-input border border-slate-200 dark:border-dark-border text-slate-900 dark:text-slate-100 focus:outline-none focus:border-brand-500">
                  <option value="dual" selected?={ model.Settings.DefaultProtocol == "dual" }>Dual Protocol</option>
                  <option value="grpc" selected?={ model.Settings.DefaultProtocol == "grpc" }>gRPC Only</option>
                </select>
              </div>
            </div>

            <div class="pt-2">
              <button type="submit" id="btnSaveSettings" class="py-2.5 px-5 rounded-xl text-xs font-bold bg-brand-500 hover:bg-brand-400 text-slate-950 transition-all shadow-md">
                Save Settings to PostgreSQL
              </button>
            </div>
          </form>
        </section>

        
        <section class="min-w-0 bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border rounded-2xl p-6 shadow-sm space-y-5" aria-labelledby="snapshotHeading">
          <div class="border-b border-slate-200 dark:border-dark-border pb-4">
            <h2 id="snapshotHeading" class="text-base font-semibold text-slate-900 dark:text-white">Snapshots and validation</h2>
          </div>
          <div id="snapshotStatus" hx-get="/ui/admin/snapshots" hx-trigger="every 5s, admin-refresh from:body" hx-swap="innerHTML" hx-sync="this:replace">
 @components.SnapshotList(model.Source)
 </div>
        </section>
      </div>

    </main>
  </div>
}
