package layouts

templ Layout(title string, bodyClass string) {
 <!DOCTYPE html>
 <html lang="en">
 <head>

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <title>{ title }</title>
  <meta name="description" content="Generate production-ready Go services with Clean Architecture, REST API, gRPC, Google Wire DI, and OpenTelemetry.">
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Ccircle cx='14' cy='14' r='4.5' fill='%2300ADD8'/%3E%3Ccircle cx='14' cy='14' r='2.2' fill='%237FE2F8'/%3E%3Ccircle cx='34' cy='14' r='4.5' fill='%2300ADD8'/%3E%3Ccircle cx='34' cy='14' r='2.2' fill='%237FE2F8'/%3E%3Cpath d='M11 23C11 16 16.8 10.5 24 10.5C31.2 10.5 37 16 37 23V34C37 38.5 33.5 42 29 42H19C14.5 42 11 38.5 11 34V23Z' fill='%2300ADD8'/%3E%3Ccircle cx='18' cy='21.5' r='5.2' fill='%23FFFFFF'/%3E%3Ccircle cx='30' cy='21.5' r='5.2' fill='%23FFFFFF'/%3E%3Ccircle cx='19.2' cy='21.5' r='2.5' fill='%230F172A'/%3E%3Ccircle cx='28.8' cy='21.5' r='2.5' fill='%230F172A'/%3E%3Ccircle cx='20.4' cy='20.3' r='0.9' fill='%23FFFFFF'/%3E%3Ccircle cx='30' cy='20.3' r='0.9' fill='%23FFFFFF'/%3E%3Cellipse cx='24' cy='27.5' rx='4.8' ry='2.8' fill='%23FFFFFF'/%3E%3Cellipse cx='24' cy='26.6' rx='2' ry='1.3' fill='%230F172A'/%3E%3Crect x='22' y='29.8' width='1.8' height='2.6' rx='0.4' fill='%23FFFFFF' stroke='%23CBD5E1' stroke-width='0.3'/%3E%3Crect x='24.2' y='29.8' width='1.8' height='2.6' rx='0.4' fill='%23FFFFFF' stroke='%23CBD5E1' stroke-width='0.3'/%3E%3C/svg%3E">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  
  
  
  
  <link rel="stylesheet" href="/css/tailwind.css"/>
<link rel="stylesheet" href="/css/style.css"/>
<meta name="htmx-config" content='{"selfRequestsOnly":true,"allowScriptTags":false,"responseHandling":[{"code":"204","swap":false},{"code":"[23]..","swap":true},{"code":"[45]..","swap":true,"error":true}]}'/>
<script src="/js/theme-init.js"></script>
<script src="/js/ui.js" defer></script>
<script src="/vendor/htmx.min.js" defer></script>
<script src="/vendor/alpine.min.js" defer></script>

 </head>
 <body class={ bodyClass } x-data="shell">
  { children... }
 </body>
 </html>
}
