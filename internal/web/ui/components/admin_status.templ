package components

import viewmodel "gostarter/internal/web/ui"


import "strconv"

templ AdminStats(source viewmodel.Source) {
<div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        
        <div class="p-5 rounded-2xl bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">PostgreSQL</span>
            <div class="text-base font-bold mt-1 text-slate-900 dark:text-white flex items-center gap-2">
              <span id="dbStatusDot" class="w-2.5 h-2.5 rounded-full bg-emerald-500 shadow"></span>
              <span id="dbStatusText">Connected</span>
            </div>
            <span class="text-[11px] font-mono text-slate-500">127.0.0.1:5432/gostarter</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-emerald-500/10 text-emerald-500 flex items-center justify-center text-lg font-bold">
            🗄️
          </div>
        </div>

        
        <div class="p-5 rounded-2xl bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Active Snapshot</span>
            <div class="text-xl font-bold mt-1 text-slate-900 dark:text-white font-mono" id="cacheFilesCount">{ viewmodel.ShortID(source.ActiveID) }</div>
            <span class="text-[11px] text-slate-500" id="sourceGoVerText">{ "Candidate: " + viewmodel.ShortID(source.CandidateID) }</span>
          </div>
          <div class="w-10 h-10 rounded-xl bg-brand-500/10 text-brand-500 flex items-center justify-center text-lg font-bold">
            ⚡
          </div>
        </div>

        
        <div class="p-5 rounded-2xl bg-white dark:bg-dark-card border border-slate-200 dark:border-dark-border shadow-sm flex items-center justify-between">
          <div>
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wider">Upstream Sync</span>
            <div class="text-sm font-bold mt-1 text-slate-900 dark:text-white truncate max-w-[150px]" id="commitShaText">{ viewmodel.ActiveCommit(source) }</div>
            <span class="text-[11px] text-slate-500" id="lastSyncTimeText">{ viewmodel.SyncStatus(source) }</span>
          </div>
          <button type="button" id="btnAdminSync" disabled?={ viewmodel.SyncBusy(source) } hx-post="/ui/admin/sync" hx-target="#adminNotice" hx-disabled-elt="this" class="p-2.5 rounded-xl border border-slate-200 dark:border-dark-border bg-slate-50 dark:bg-dark-surface hover:border-brand-500 transition-all text-xs font-semibold text-brand-500 flex items-center gap-1 shadow-sm disabled:opacity-50 disabled:cursor-not-allowed" title="Sync now">
            <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <path d="M21.5 2v6h-6M2.5 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 4.2"/>
            </svg>
          </button>
        </div>
      </div>
}

templ Notice(message string, failed bool) {
 <p class={ "text-xs p-2.5 rounded-xl", templ.KV("bg-rose-500/10 text-rose-600 dark:text-rose-400", failed), templ.KV("bg-brand-500/10 text-brand-600 dark:text-brand-400", !failed) } role="status">{ message }</p>
}

templ SnapshotList(source viewmodel.Source) {
 <div class="space-y-1 text-slate-500 dark:text-slate-400">
  <p id="adminSource" class="text-xs break-all">{ source.Repository + "@" + source.Ref }</p>
  <p id="adminSchedule" class="text-xs">{ viewmodel.SyncStatus(source) }</p>
  <p id="adminSyncError" class="text-xs text-rose-500" role="status">{ source.SyncError }</p>
 </div>
 <div id="adminSnapshots" class="space-y-3 mt-3">
  for _, snapshot := range source.Snapshots {
   <section class="border border-slate-200 dark:border-dark-border rounded-xl p-3 text-xs break-all space-y-1">
    <strong>
     if snapshot.ID == source.ActiveID {
 { "Active · " }
 }
     if snapshot.ID == source.CandidateID {
 { "Candidate · " }
 }
     { snapshot.Repository + "@" + snapshot.Ref }
    </strong>
    <p>{ snapshot.CommitSHA }</p>
    <p>{ "Snapshot " + snapshot.ID }</p>
    <p>{ "Source: " + snapshot.Status + " · validation: " + snapshot.ValidationStatus }</p>
    <p>{ snapshot.Diagnostic }</p>
    <form method="post" action="/ui/admin/rollback" hx-post="/ui/admin/rollback" hx-target="#adminNotice" hx-disabled-elt="find button">
     <input type="hidden" name="snapshot_id" value={ snapshot.ID }/>
     <input type="hidden" name="revision" value={ strconv.FormatInt(source.Revision, 10) }/>
     <input type="hidden" name="candidate_epoch" value={ strconv.FormatInt(source.CandidateEpoch, 10) }/>
     <button type="submit" class="text-brand-600 dark:text-brand-400" disabled?={ !viewmodel.CanRollback(source, snapshot) }>Activate / rollback</button>
    </form>
   </section>
  }
 </div>
}
