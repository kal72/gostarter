#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
# Install explicitly if unavailable: protobuf v1.36.11, go-grpc v1.6.2,
# grpc-gateway/openapiv2 v2.29.0. protoc must be 34.0. No automatic installation.
[[ $(protoc --version) == 'libprotoc 34.0' ]] || { echo 'requires protoc 34.0' >&2; exit 1; }
for tool in protoc-gen-go protoc-gen-go-grpc protoc-gen-grpc-gateway protoc-gen-openapiv2; do
  command -v "$tool" >/dev/null
  case "$tool" in
    protoc-gen-go) expected=v1.36.11 ;;
    protoc-gen-go-grpc) expected=v1.6.2 ;;
    *) expected=v2.29.0 ;;
  esac
  actual=$(go version -m "$(command -v "$tool")" | awk '$1 == "mod" { print $3 }')
  [[ "$actual" == "$expected" ]] || { echo "$tool requires $expected, found $actual" >&2; exit 1; }
done
gateway="$(go env GOMODCACHE)/github.com/grpc-ecosystem/grpc-gateway/v2@v2.29.0"
mkdir -p gen/pb<<%if eq .Protocol "dual"%>> gen/openapi<<%end%>>
protoc -I api/proto/plugins -I api/proto -I "$gateway" \
  --go_out=gen/pb --go_opt=paths=source_relative \
  --go-grpc_out=gen/pb --go-grpc_opt=paths=source_relative \
  --grpc-gateway_out=gen/pb --grpc-gateway_opt=paths=source_relative \
  <<%if eq .Protocol "dual"%>>--openapiv2_out=gen/openapi --openapiv2_opt=allow_merge=true,merge_file_name=api \
<<%end%>>  <<%range .Protos%>><<%shellquote .%>> <<%end%>>
