syntax = "proto3";

package openapi;

option go_package = "<<%.Module%>>/gen/pb;openapipb";

import "protoc-gen-openapiv2/options/annotations.proto";

// Global OpenAPI / Swagger metadata for the entire API.
// This file acts as the single place to configure info, security definitions,
// and any other spec-level settings. Individual service files should NOT
// duplicate these settings.
option (grpc.gateway.protoc_gen_openapiv2.options.openapiv2_swagger) = {
  info: {
    title: <<%quote .ServiceName%>>;
    version: <<%quote .ProjectVersion%>>;
    description: <<%quote .Description%>>;
  };
  schemes: HTTP;
  schemes: HTTPS;
  consumes: "application/json";
  produces: "application/json";
  security_definitions: {
    security: {
      key: "bearer";
      value: {
        type: TYPE_API_KEY;
        in: IN_HEADER;
        name: "Authorization";
        description: "Authentication token, prefixed by Bearer: Bearer <token>";
      }
    }
  };
  security: {
    security_requirement: {
      key: "bearer";
      value: {};
    }
  };
};
