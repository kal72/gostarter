+
+func isolateConfig(t *testing.T) {
+	t.Helper()
+	t.Chdir(t.TempDir())
+	for _, entry := range os.Environ() {
+		key, _, _ := strings.Cut(entry, "=")
+		for _, prefix := range []string{"APP_", "SERVER_", "DB_", "MONGO_", "REDIS_", "JWT_", "LOG_", "OTEL_", "COMPANY_SERVICE_"} {
+			if strings.HasPrefix(key, prefix) {
+				t.Setenv(key, "")
+			}
+		}
+	}
+}
